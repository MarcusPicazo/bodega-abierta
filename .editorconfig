root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

[*.{json,yml,yaml,props,csproj,slnx}]
indent_size = 2

# EF Core migrations are generated code: don't run analyzers on them.
[**/Migrations/*.cs]
generated_code = true

# Test names read as sentences: Tenant_only_sees_its_own_rows.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
