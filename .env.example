# Copy to .env (git-ignored) and choose a strong password:
# at least 8 chars with upper case, lower case, digits and a symbol.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!

# The API reads its connection string from user-secrets (Development) or this env var:
#   dotnet user-secrets set "ConnectionStrings:BodegaAbierta" "Server=localhost,1434;Database=BodegaAbierta;User Id=sa;Password=<same password>;TrustServerCertificate=True" --project src/BodegaAbierta.Api
